# Copy to .env and fill in. Do NOT commit .env to git.

# Your Supabase project URL — without trailing slash.
# Find at: https://supabase.com/dashboard/project/<ref>/settings/api
SUPABASE_URL=https://fcgjgtqqcuafbmhwmzfq.supabase.co

# Your project's JWT secret (HS256). Needed because your project predates
# the January 2026 ES256 default. Even after you rotate to asymmetric keys,
# keep this set so tokens issued before rotation still verify.
# Find at: Settings -> API -> JWT Settings -> JWT Secret.
SUPABASE_JWT_SECRET=replace-me-with-actual-secret

# Optional. Defaults to "authenticated". Override only if you've changed
# the audience claim on your Supabase project.
# SUPABASE_JWT_AUDIENCE=authenticated

# Optional. Defaults to 600 seconds.
# SUPABASE_JWKS_CACHE_TTL=600

# Comma-separated list of allowed origins for CORS.
# Include the deployed Lovable URL plus localhost for dev.
ALLOWED_ORIGINS=https://your-lovable-app.lovable.app,http://localhost:5173

# Optional. The service-role key, used by Sprint 2+ when the engine reads
# Supabase tables directly (bypassing RLS).
# SUPABASE_SERVICE_ROLE_KEY=replace-me

# Server port (Cloud Run sets this for you; set explicitly only for local).
PORT=8001
