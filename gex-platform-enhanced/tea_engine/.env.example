# tea_engine configuration (copy to .env for local dev)

# --- GEX JWT bridge (one identity issuer, ADR 2026-07-06) ---
# Supabase verification is RETIRED. tea_engine verifies GEX platform tokens
# only, via auth/gex_jwt.py — the same bridge gex_pf_engine uses.
# GEX_JWT_SECRET must match the platform backend's SECRET_KEY, or every call
# from the backend is rejected and surfaces as "TEA engine unavailable".
GEX_JWT_SECRET=dev_secret_key_change_in_production
GEX_JWT_ISSUER=https://api.greenearthx.com
GEX_JWT_AUDIENCE=gex-platform
# GEX_JWKS_URL=http://localhost:8000/api/v1/auth/jwks   # RS256 path
# GEX_JWKS_CACHE_TTL=600

# --- TEA engine ---
# Real OpenPyTEA by default. Set TEA_STUB=1 for deterministic stub output
# (CI / demo without the numpy/scipy/matplotlib stack).
TEA_STUB=0
# TEA_ENGINE_VERSION=sprint1

PORT=8002
LOG_LEVEL=INFO
DEV=1
