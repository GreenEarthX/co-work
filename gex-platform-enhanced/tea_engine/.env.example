# tea_engine configuration (copy to .env for local dev)

# --- Supabase JWT bridge (shared with gex_pf_engine) ---
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_JWT_SECRET=<legacy-jwt-secret>     # needed for HS256 tokens
# SUPABASE_JWT_AUDIENCE=authenticated

# --- TEA engine ---
# Real OpenPyTEA by default. Set TEA_STUB=1 for deterministic stub output
# (CI / demo without the numpy/scipy/matplotlib stack).
TEA_STUB=0
# TEA_ENGINE_VERSION=sprint1

PORT=8002
LOG_LEVEL=INFO
DEV=1
