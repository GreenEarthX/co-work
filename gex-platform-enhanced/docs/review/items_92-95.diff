@@ -0,0 +1,45 @@
+import { describe, expect, it } from 'vitest'
+import { createQueryClient, failureStatus, isSensitive } from './sensitiveQueries'
+
+const refusal = (status: number) => Object.assign(new Error('refused'), { status })
+
+describe('pre-FID queries are never shown from cache (handoff v4 task 9)', () => {
+  it('names the sensitive roots only', () => {
+    expect(isSensitive(['packages', 'P1'])).toBe(true)
+    expect(isSensitive(['devex-brief', 'P1'])).toBe(true)
+    expect(isSensitive(['gates', 'P1'])).toBe(false)
+  })
+
+  it('reads the status from the error or its message', () => {
+    expect(failureStatus(refusal(403))).toBe(403)
+    expect(failureStatus(new Error('HTTP 503'))).toBe(503)
+    expect(failureStatus(new Error('boom'))).toBeUndefined()
+  })
+
+  it('a 403 after a success clears the figures the query held', async () => {
+    const client = createQueryClient()
+    client.setQueryData(['packages', 'P1'], [{ package_id: 'dev' }])
+    await client.fetchQuery({ queryKey: ['packages', 'P1'], queryFn: () => Promise.reject(refusal(403)), retry: false }).catch(() => {})
+    const state = client.getQueryState(['packages', 'P1'])
+    expect(state?.status).toBe('error')
+    expect(state?.data).toBeUndefined()
+  })
+
+  it('a 503 clears too; a non-sensitive query keeps its last data', async () => {
+    const client = createQueryClient()
+    client.setQueryData(['devex-brief', 'P1'], { data: { total: 1 } })
+    client.setQueryData(['gates', 'P1'], { g: 1 })
+    for (const key of [['devex-brief', 'P1'], ['gates', 'P1']]) {
+      await client.fetchQuery({ queryKey: key, queryFn: () => Promise.reject(refusal(503)), retry: false }).catch(() => {})
+    }
+    expect(client.getQueryData(['devex-brief', 'P1'])).toBeUndefined()
+    expect(client.getQueryData(['gates', 'P1'])).toEqual({ g: 1 })
+  })
+
+  it('sensitive queries are kept for nobody and refetched on every mount', () => {
+    const d = createQueryClient().getQueryDefaults(['packages', 'P1'])
+    expect(d.gcTime).toBe(0)
+    expect(d.refetchOnMount).toBe('always')
+    expect(d.staleTime).toBe(0)
+  })
+})
diff --git a/frontend/src/lib/sensitiveQueries.ts b/frontend/src/lib/sensitiveQueries.ts
new file mode 100644
index 0000000..b12907c
--- /dev/null
+++ b/frontend/src/lib/sensitiveQueries.ts
@@ -0,0 +1,44 @@
+/**
+ * Pre-FID, derived and returns queries are never shown from cache (handoff v4, task 9).
+ *
+ * The server sends these with `Cache-Control: no-store` (backend app/core/no_store.py).
+ * Here, for every query whose key starts with one of SENSITIVE_ROOTS:
+ *   - nothing is kept once no screen uses it (gcTime 0), and a screen that mounts
+ *     always refetches, so a revoked share is never shown from an earlier answer;
+ *   - a 403 or 503 clears the data the query held, so the refusal or outage is
+ *     shown, never the figures from before it.
+ */
+import { QueryCache, QueryClient, type Query } from '@tanstack/react-query'
+
+export const SENSITIVE_ROOTS = [
+  'packages', 'devex-brief', 'devex-shares', 'spend-wave', 'returns-cases', 'returns-shares',
+  'returns-case', 'pre-cod-metrics', 'capital-bridge', 'lineage',
+] as const
+
+export function isSensitive(queryKey: readonly unknown[]): boolean {
+  return typeof queryKey[0] === 'string' && (SENSITIVE_ROOTS as readonly string[]).includes(queryKey[0])
+}
+
+export function failureStatus(error: unknown): number | undefined {
+  const e = error as { status?: number; response?: { status?: number }; message?: string } | null
+  const status = e?.status ?? e?.response?.status
+  if (typeof status === 'number') return status
+  const m = /\b(403|503)\b/.exec(e?.message ?? '')
+  return m ? Number(m[1]) : undefined
+}
+
+export function clearOnRefusal(error: unknown, query: Query<unknown, unknown, unknown, readonly unknown[]>): boolean {
+  const status = failureStatus(error)
+  if (!isSensitive(query.queryKey) || (status !== 403 && status !== 503)) return false
+  // Keep the error, drop the data: the screen shows the refusal, not the old figures.
+  query.setState({ data: undefined, dataUpdatedAt: 0 })
+  return true
+}
+
+export function createQueryClient(): QueryClient {
+  const client = new QueryClient({ queryCache: new QueryCache({ onError: (error, query) => { clearOnRefusal(error, query) } }) })
+  for (const root of SENSITIVE_ROOTS) {
+    client.setQueryDefaults([root], { gcTime: 0, staleTime: 0, refetchOnMount: 'always' })
+  }
+  return client
+}
