  "vocabulary": {
    "extraction": {
      "EXTRACTED": "Field read; identity scope established by the specification (mapping v0.2 §1).",
      "IDENTITY_UNRESOLVED": "Recorded, not refused; cannot support a verified claim or confirm an allocation (§1 rule 4).",
      "MAPPING_NOT_CONFIRMED": "Field read, but its GEX meaning is NOT CONFIRMED in the mapping (§2, §3).",
      "UNIT_REFUSED": "Unit refused: a volume or a unit whose meaning is not confirmed (§3).",
      "UNIT_NOT_CONVERTIBLE": "No approved conversion between the evidence unit and the input unit (§2: hydrogen MWh to kg)."
    },
    "match": {
      "MATCH": "The extracted value agrees with the GEX input.",
      "MISMATCH": "It does not."
    },
    "allocation_request": {
      "PROVISIONAL": "Recorded with the declared quantity; nothing reserved (§5.7).",
      "PROVISIONAL_OVERLAP_FLAGGED": "Recorded; a potential overlap flagged privately for authorised review; nothing reserved (§5.7)."
    },
    "requester_sees": {
      "DETAIL": "Within the tenant: the authorised detail.",
      "REVIEW_PENDING": "Across tenants: only that a review is pending, never another company's data (§5.7)."
    },
    "confirmation": {
      "CONFIRMABLE": "Identity, quantity and eligibility checks pass; availability rechecked atomically at confirmation (§5.7).",
      "NOT_CONFIRMABLE": "A check is unresolved or eligibility is not established.",
      "REFUSED_NEUTRAL": "Refused with exactly the neutral_refusal_text, for any cause the requester cannot see into; no other company's data, no database message (§5.11).",
      "REFUSED_WITH_DETAIL": "Availability fails at confirmation; within the tenant the authorised detail is given (§5.7).",
      "REFUSED_BELOW_UNIT": "The request divides the document below the unit the rule establishes (§5.3).",
      "REFUSED_OWN_DATA_DETAIL": "Refused for a reason derived only from what the requester submitted or holds; detail may be given (§5.11)."
    },
    "eligibility": {
      "NOT_ESTABLISHED": "No approved rule row: never implicit permission (§5.5).",
      "COMPATIBLE": "An approved rule row says compatible.",
      "INCOMPATIBLE": "An approved rule row says incompatible."
    },
    "document_overlap": {
      "NONE": "No overlap with another recorded document.",
      "RECORDED": "Overlap between documents recorded; not refused: documents may legitimately describe the same certificates (§5.3)."
    },
    "label": {
      "DECLARED": "Offline evidence is the party's declaration; only registry confirmation could make it VERIFIED."
    },
    "unit_outcome": {
      "ACCEPTED": "Accepted with the stated conversion.",
      "UNIT_REFUSED": "Refused."
    },
    "divisibility": {
      "ESTABLISHED": "An approved rule states the unit the document divides to (§5.5, §5.8).",
      "NOT_ESTABLISHED": "No rule states a unit: one allocation of the whole eligible quantity, or none (§5.3)."
    },
    "concurrency": {
      "EXACTLY_ONE_CONFIRMED": "Of simultaneous confirmations that cannot both fit, exactly one succeeds (§5.7)."
    },
    "validity": {
      "VALID_AT_EVENT": "Valid at the date(s) the rule tests (§9.2).",
      "NOT_VALID_AT_EVENT": "Not valid at a date the rule tests (§9.2).",
      "NOT_VALID_OVER_PERIOD": "A continuing condition fails during the period the rule tests (§9.2)."
    },
    "historical_decision": {
      "PRESERVED": "The earlier decision stays on record; any reassessment is a new linked decision (§9.2)."
    },
    "reassessment": {
      "REQUIRED": "A withdrawal or suspension in scope reaches back over the allocation's event dates (§9.2).",
      "CONSIDERED_NO_CHANGE": "Assessed against reason, scope and effective date; the allocation is unaffected (§9.2)."
    },
    "downstream": {
      "REASSESSMENT_PENDING": "Downstream claims wait for the reassessment (§9.2).",
      "UNAFFECTED": "Downstream claims are not affected."
    },
    "quantity_state": {
      "RESTORED": "Available again after an authorised reversal with no active dependents (§9.3).",
      "RESTRICTED": "Not available for another allocation (§9.2, §9.3)."
    },
    "correction": {
      "REVERSED": "Authorised, linked reversal entry recorded (§9.3).",
      "REFUSED_DEPENDENTS_ACTIVE": "Refused while dependents are active (§9.3).",
      "SUPERSEDED_DRAFT": "A generated, unsubmitted file is superseded by a replacement (§9.3).",
      "PENDING_EXTERNALLY": "Submission is evidenced; waits for the external acknowledgement (§9.3)."
    },
    "external_ack": {
      "REQUIRED": "An external acknowledgement must be recorded.",
      "NOT_REQUIRED": "No external acknowledgement is needed."
    },
    "approval": {
      "FOUR_EYES": "Proposed and approved by two different people of the company (§9.3)."
    },
    "reference": {
      "UNRESOLVED_ASSERTION": "Free text kept as an assertion: no access, no claim (§5.10).",
      "SHARED_REFERENCE_ALLOWED": "Several companies may reference the same document; each keeps its own record (§5.11)."
    },
    "disclosure": {
      "INDISTINGUISHABLE_FROM_UNKNOWN": "The answer is the same as for an unknown identifier (§5.10)."
    },
    "evidence_records": {
      "ONE_PER_COMPANY": "One evidence record per company; linked only in the operator-side identity index (§5.11)."
    },
    "priority": {
      "NONE": "The first uploader gains no exclusive right (§5.11)."
    }
  },
