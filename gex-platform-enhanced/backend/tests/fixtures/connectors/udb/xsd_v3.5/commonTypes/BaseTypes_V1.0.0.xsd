	<xs:simpleType name="emailAddress">
		<xs:annotation>
			<xs:documentation>Simple type for email addresses</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:pattern value="[A-Za-z0-9](([_\.\-]?[a-zA-Z0-9]+)*)@([A-Za-z0-9]+)(([\.\-]?[a-zA-Z0-9]+)*)\.([A-Za-z]{2,})"/>
			<xs:maxLength value="255"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="FileReference">
		<xs:annotation>
			<xs:documentation>URI of a file attached to the payload.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:anyURI"/>
	</xs:simpleType>
	<xs:simpleType name="httpURL">
		<xs:annotation>
			<xs:documentation>Simple type for an URL</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:anyURI">
			<xs:pattern value="(https?)://(-|[a-z]|[A-Z]|[0-9]|_|@|:|\+|&amp;)+(\.([a-z]|[A-Z]|[0-9]|-|_|/|\/|\(|\)|\?|\=|&amp;|:|#|\%|\?)+)+"/>
			<xs:maxLength value="2000"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="LatitudeDT">
