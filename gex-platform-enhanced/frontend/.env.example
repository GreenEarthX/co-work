# Add to .env.local (Vite picks these up at build time).
# Only variables prefixed VITE_ are exposed to the browser bundle.

# URL of the deployed gex_pf_engine. After `gcloud run deploy` this comes back
# in the form https://<service>-<hash>-<region>.run.app
VITE_GEX_ENGINE_URL=https://gex-pf-engine-xxxxxx.run.app
