FROM python:3.11-slim
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    postgresql-client \
    libolm-dev \
    && rm -rf /var/lib/apt/lists/*
COPY gex-platform-enhanced/backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY gex-platform-enhanced/backend/ .
# Runtime data file that lives outside the backend tree in the dev checkout
COPY gex_fuel_catalog.json /app/gex_fuel_catalog.json
EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "4"]
